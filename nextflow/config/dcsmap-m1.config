// ============================================================================
// Configuration template for the DCSMAP-M1 pipeline (merge-first variant)
// (BWA-MEM2 + extract-bam -> VG haplotype sampling -> VG Giraffe map ->
//  merge BWA-MEM2 BAM + VG Giraffe surject BAM -> abra2 realign (once, on
//  the merged BAM) -> DeepVariant -> benchmarking).
//
// Differs from dcsmap.nf only in step ordering: dcsmap.nf realigns the VG
// Giraffe surject BAM first and merges afterwards; DCSMAP-M1 merges first
// and realigns the merged BAM once.
//   Workflow script: ../dcsmap-m1.nf
//
// Usage:
//   nextflow run ../dcsmap-m1.nf -c dcsmap-m1.config -work-dir work
//
// Replace every placeholder / relative path below with your own dataset paths
// (keep them relative or accessible from the launch directory).
// ============================================================================

params {
    // ---- Sample inputs -----------------------------------------------------
    sample_name = "HG002"
    platform    = "Illumina"
    fq1         = "data/fastq/HG002.R1.fastq.gz"
    fq2         = "data/fastq/HG002.R2.fastq.gz"
    threads     = 32

    // ---- Tools -------------------------------------------------------------
    tools_root   = "./tools"
    java_home    = "tools/jdk"             // JDK used by VG/ABRA2 realign step
    extract_model = "models/NA12891.xgb.model-v2.2.json"

    // ---- Reference + vg graph resources ------------------------------------
    // Option A: set ref_type to auto-derive ref_fasta / gbz / hapl /
    //           ref_contigs from the HPRC data directory. ref_type also drives
    //           the --set-reference value passed to vg haplotypes (must match
    //           the graph's reference path-name prefix):
    //             ref_type = "GRCh38"  -> .../data/hprc         (set-reference GRCh38)
    //             ref_type = "CHM13"  -> .../data/hprc-v2-chm13 (set-reference CHM13)
    // Option B: set the four paths explicitly (override ref_type). When
    //           ref_type is unset, set-reference defaults to 'GRCh38'.
    ref_type      = "GRCh38"
    ref_fasta   = "data/ref/hprc-v2.0-mc-grch38.ref.fasta"
    gbz         = "data/vg/hprc-v2.0-mc-grch38.gbz"
    hapl        = "data/vg/hprc-v2.0-mc-grch38.hapl"
    ref_contigs = "data/vg/hprc-v2.0-mc-grch38.ref.pathnames"

    // ---- DeepVariant (core step, singularity) ------------------------------
    deepvariant_sif     = "containers/deepvariant_v1.10.0.sif"
    disable_small_model = false
    use_make_examples_extra_args = true   // pass --make_examples_extra_args to DeepVariant make_examples
    bind_path           = "data/"          // data root bound into singularity containers

    // ---- RTG benchmark (optional) -----------------------------------------
    use_rtg               = true
    rtg_sif               = "containers/giab_small_variant_benchmark.v1.0.0.sif"
    rtg_tag               = "DCSMAP-M1-DV"
    giab_version          = "v4.2.1"
    giab_stratify_version = "v2.0"

    // ---- hap.py benchmark (optional) --------------------------------------
    // run_hap.py.sh picks the truth set by assembly (-a) and GIAB version
    // (-v). The workflow passes ref_type as the assembly and selects the
    // GIAB version automatically: v5.0q for CHM13 (HG002 only), else
    // params.giab_version (v4.2.1 default). Override with happy_giab_version.
    // For CHM13 leave happy_ref empty to let run_hap.py.sh default the ref.
    use_happy          = true
    happy_home          = "tools/run_hap.py"
    happy_sif           = "containers/hap.py.v0.3.12.sif"
    happy_ref           = "data/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"
    happy_giab_version  = null

    // ---- biastools mapping-bias analysis (optional) ------------------------
    use_biastools  = true
    biastools_bin  = "envs/python3/bin/biastools"
    biastools_tag  = "DCSMAP-M1"
    biastools_depth = 30

    // ---- Output ------------------------------------------------------------
    outdir              = "./results"
    publish_mode        = "link"
    publish_abra2_bam   = true             // publish merged+realigned abra2 BAM to <outdir>/merged_realign/
    publish_merged_bam  = false            // merged BAM is only an intermediate input to REALIGN (do not publish)

    // ---- Realign -----------------------------------------------------------
    use_gkl           = true             // pass --gkl to abra2 in REALIGN (set false to disable)
}

process {
    executor = 'local'

    withName: 'BWA_MEM2_MAP_AND_EXTRACT' { cpus = 32; memory = '128 GB' }
    withName: 'VG_HAPLOTYPE_SAMPLING'    { cpus = 32; memory = '128 GB' }
    withName: 'VG_GIRAFFE'               { cpus = 32; memory = '128 GB' }
    withName: 'MERGE_BAMS'               { cpus = 32; memory = '128 GB' }
    withName: 'REALIGN'                  { cpus = 32; memory = '128 GB' }
    withName: 'DEEPVARIANT'              { cpus = 32; memory = '128 GB' }
    withName: 'RTG_VCF_EVAL'             { cpus = 32; memory = '128 GB' }
    withName: 'HAPPY'                    { cpus = 32; memory = '128 GB' }
    withName: 'BIASTOOLS'                { cpus = 32; memory = '128 GB' }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report  { enabled = true; file = "${params.outdir}/pipeline_info/report.html";  overwrite = true }
trace   { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";    overwrite = true }
dag     { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";     overwrite = true }

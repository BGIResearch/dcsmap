// ============================================================================
// Configuration template for the BWA-MEM2 germline variant calling pipeline.
//   Workflow script: ../bwa-mem2.nf
//
// Usage:
//   nextflow run ../bwa-mem2.nf -c bwa-mem2.config -work-dir work
//
// Replace every placeholder marked with <...> and the relative paths below
// with your own dataset paths (keep them relative or use paths accessible
// from the launch directory -- no absolute paths are required here).
// ============================================================================

params {
    // ---- Sample inputs -----------------------------------------------------
    sample_id   = "HG002"
    fq1         = "data/fastq/HG002.R1.fastq.gz"
    fq2         = "data/fastq/HG002.R2.fastq.gz"

    // ---- Reference (BWA-MEM2 index, .dict and .fai must sit alongside) -----
    ref         = "data/ref/hprc-v2.0-mc-grch38.ref.fasta"

    // ---- GATK BQSR known-sites (comma-separated VCFs, each with a .tbi) ----
    known_sites = "data/known_sites/dbsnp_151.hg38.vcf.gz,data/known_sites/1000G_phase1.snps.high_confidence.hg38.vcf.gz,data/known_sites/hapmap_3.3.hg38.vcf.gz,data/known_sites/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

    // ---- Tools -------------------------------------------------------------
    gatk        = "tools/gatk/gatk"
    threads     = 32

    // ---- Output ------------------------------------------------------------
    outdir      = "./results"
    publish_mode = "copy"

    // ---- Caller switches ---------------------------------------------------
    use_gatk       = true
    use_deepvariant = true

    // ---- DeepVariant (singularity) ----------------------------------------
    deepvariant_sif     = "containers/deepvariant_v1.10.0.sif"
    disable_small_model = false
    use_make_examples_extra_args = false   // bwa-mem2: do not pass --make_examples_extra_args
    bind_path           = "data/"          // data root bound into singularity containers

    // ---- RTG benchmark (optional) -----------------------------------------
    use_rtg               = true
    rtg_sif               = "containers/giab_small_variant_benchmark.v1.0.0.sif"
    rtg_tag               = "BWA-MEM2"
    giab_version          = "v4.2.1"
    giab_stratify_version = "v2.0"

    // ---- hap.py benchmark (optional) --------------------------------------
    use_happy  = true
    happy_home = "tools/run_hap.py"        // contains run_hap.py.sh + data/
    happy_sif  = "containers/hap.py.v0.3.12.sif"
    happy_ref  = "data/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"

    // ---- biastools mapping-bias analysis (optional) ------------------------
    use_biastools  = true
    biastools_bin  = "envs/python3/bin/biastools"
    biastools_tag  = "BWA-MEM2"
    biastools_depth = 30
}

process {
    executor = 'local'

    withName: 'BWA_MEM2' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'SAMBAMBA_MARKDUP' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'GATK_BQSR' {
        cpus   = 32
        memory = '128 GB'
    }
    // Per-chromosome HaplotypeCaller: many contigs, most empty for a small
    // subset. maxForks lets the (fast) empty intervals run concurrently.
    withName: 'GATK_HAPLOTYPECALLER' {
        cpus     = 2
        memory   = '6 GB'
        maxForks = 16
    }
    withName: 'MERGE_GVCFS' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'GATK_GENOTYPE_GVCFS' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'DEEPVARIANT' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'RTG_VCF_EVAL' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'HAPPY' {
        cpus   = 32
        memory = '128 GB'
    }
    withName: 'BIASTOOLS' {
        cpus   = 32
        memory = '128 GB'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report  { enabled = true; file = "${params.outdir}/pipeline_info/report.html";  overwrite = true }
trace   { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";    overwrite = true }
dag     { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";     overwrite = true }
